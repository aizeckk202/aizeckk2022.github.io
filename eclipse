  <div class="btn-wrap">
    <button class="btn" onclick="goTo('page4')">Закрыть 💌</button>
  </div>
</div>

<!-- ================= СТРАНИЦА 4 (финал) ================= -->
<div class="page" id="page4">
  <div class="cute-img">😏💖</div>
  <h1 class="title">Айшу, я тебя очень сильно люблю, очень 💗</h1>
  <div class="hearts-line">💖 💘 💖 💘 💖</div>
  <div class="text">И эта открытка — возможно, не последний такой милый знак внимания… УХЕХЕХЕ 😼💕</div>
  <div class="btn-wrap">
    <button class="btn" onclick="goTo('page1')">Начать заново 🔁</button>
  </div>
</div>

<script>
/* ---------- Переключение страниц ---------- */
function goTo(id) {
  document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
  const el = document.getElementById(id);
  // перезапуск анимации появления
  el.style.animation = 'none';
  void el.offsetWidth;
  el.style.animation = '';
  el.classList.add('active');
  window.scrollTo({ top:0, behavior:'smooth' });
}

/* ---------- Убегающая кнопка "нет, кто ты?" ---------- */
const runaway = document.getElementById('runawayBtn');

function dodge(e) {
  // на всякий случай — на мобилках по тапу тоже убегает
  if (e) e.preventDefault();

  const btnW = runaway.offsetWidth;
  const btnH = runaway.offsetHeight;
  const maxX = window.innerWidth  - btnW - 20;
  const maxY = window.innerHeight - btnH - 20;

  const x = Math.max(20, Math.random() * maxX);
  const y = Math.max(20, Math.random() * maxY);

  runaway.classList.add('runaway');
  runaway.style.left = x + 'px';
  runaway.style.top  = y + 'px';
}

/* убегает при приближении курсора */
runaway.addEventListener('mousemove', dodge);
/* и при любой попытке клика/тапа */
runaway.addEventListener('mouseenter', dodge);
runaway.addEventListener('click', dodge);
runaway.addEventListener('touchstart', dodge, {passive:false});

/* ---------- Летающие сердечки ---------- */
const heartEmojis = ['💖','💗','💕','💞','💘','🩷','❤️','💝'];
function spawnHearts() {
  for (let i = 0; i < 30; i++) {
    const h = document.createElement('div');
    h.className = 'float-heart';
    h.textContent = heartEmojis[Math.floor(Math.random()*heartEmojis.length)];
    h.style.left = Math.random() * 100 + 'vw';
    h.style.fontSize = (Math.random() * 22 + 16) + 'px';
    h.style.animationDuration = (Math.random() * 8 + 8) + 's';
    h.style.animationDelay = (Math.random() * 12) + 's';
    document.body.appendChild(h);
  }
}
spawnHearts();

/* ---------- Клик по пустому фону тоже рождает сердечко ---------- */
document.addEventListener('click', (e) => {
  if (e.target.closest('.page')) return; // не мешаем кнопкам
  const h = document.createElement('div');
  h.className = 'float-heart';
  h.textContent = '💖';
  h.style.left = (e.clientX - 12) + 'px';
  h.style.bottom = (window.innerHeight - e.clientY) + 'px';
  h.style.animationDuration = '3s';
  h.style.animationDelay = '0s';
  h.style.opacity = '1';
  document.body.appendChild(h);
  setTimeout(() => h.remove(), 3200);
});
</script>
</body>
</html>
